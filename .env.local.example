# Alem Admin — environment variables
# Supabase project ref: wryujrttqxoesahcxdys
#
# Copy this file to `.env.local` and fill in the values from:
#   Supabase Dashboard → Project Settings → API
#
# `.env.local` is git-ignored. This `.example` file is committed and must
# NEVER contain real keys.

# Public project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://wryujrttqxoesahcxdys.supabase.co

# Anon (public) key. Safe to expose to the browser — Row Level Security is
# what actually protects your data. Anything prefixed NEXT_PUBLIC_ is inlined
# into the client bundle by Next.js, so ONLY put public values here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY. Bypasses Row Level Security entirely.
# NEVER prefix this with NEXT_PUBLIC_. It is read in exactly one place:
# lib/supabase/admin.ts, which starts with `import 'server-only'` so the build
# fails if it is ever pulled into browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
